# Copy to .env.local and fill in. Never commit .env.local.
# Only NEXT_PUBLIC_ values are visible in the browser.

# Site
NEXT_PUBLIC_SITE_URL=

# Supabase (create project in region ap-south-1)
# Legacy anon and service_role JWT keys are deprecated. Use publishable
# and secret keys (sb_publishable_..., sb_secret_...). RLS rules do not change.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Redirect cache (Upstash Redis or Vercel KV)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Safety
GOOGLE_SAFE_BROWSING_API_KEY=

# Google sign in (configured in Supabase Auth)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Monitoring and analytics
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# Search Console (HTML meta tag token)
NEXT_PUBLIC_GSC_VERIFICATION=

# Ads (none | gam | adsense). Start with none.
NEXT_PUBLIC_AD_PROVIDER=none
NEXT_PUBLIC_GAM_NETWORK_CODE=
NEXT_PUBLIC_GAM_REWARDED_UNIT=
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=

# Billing
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Global billing (Stripe, Paddle or Lemon Squeezy), added when going global
GLOBAL_BILLING_SECRET_KEY=
GLOBAL_BILLING_WEBHOOK_SECRET=
